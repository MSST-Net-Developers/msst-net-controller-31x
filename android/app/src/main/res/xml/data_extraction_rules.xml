<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 私钥不在 include 范围内故自动排除 -->
        <include domain="file" path="identity.json" />
        <include domain="file" path="config.yaml" />
    </cloud-backup>
    <device-transfer>
        <!-- 仅传输身份和配置文件 -->
        <include domain="file" path="identity.json" />
        <include domain="file" path="config.yaml" />
    </device-transfer>
</data-extraction-rules>