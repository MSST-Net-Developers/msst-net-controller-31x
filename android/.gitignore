# ── Gradle 构建产物 ────────────────────────────────────────────────────────────
build/
**/build/
.gradle/

# ── 本地配置（包含 SDK 路径，各开发者不同）────────────────────────────────────
local.properties

# ── 签名密钥 ──────────────────────────────────────────────────────────────────
*.jks
*.keystore

# ── APK / AAB 构建产物及 release 输出目录 ─────────────────────────────────────
# （output-metadata.json、baselineProfiles/ 等 AGP 生成文件均在此目录下）
**/release/
*.apk
*.aab
*.ap_

# ── Android Studio captures ───────────────────────────────────────────────────
captures/
*.hprof
# ── Rust JNI glue: build output and the .so files copied into the app ────────
rust/target/
app/src/main/jniLibs/
